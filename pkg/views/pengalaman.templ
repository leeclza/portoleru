package views

import (
	"fmt"
	"strconv"

	"github.com/leeclza/portofolio-leon/pkg/data"
)

// typing speed per character, same as the old setTimeout(type, 18)
const typeMs = 18

templ PengalamanPage(tab string, itOnly bool) {
	@Layout("Pengalaman - Portofolio Leon") {
		<section id="pengalaman" class="py-16 px-6">
			<!-- TITLE -->
			<h2 class="anim-fade-down text-center mt-10 mb-8 text-5xl leading-tight font-semibold text-black">
				Pengalaman
			</h2>
			<div id="pengalaman-body" class="anim-fade-down-sm">
				@PengalamanBody(tab, itOnly)
			</div>
			<!-- MODAL slot, filled by htmx -->
			<div id="modal"></div>
		</section>
	}
}

// PengalamanBody is the part re-rendered when switching tab or IT filter.
templ PengalamanBody(tab string, itOnly bool) {
	<!-- TABS -->
	<div class="flex flex-col items-center gap-2 mb-2">
		<div class="flex items-center gap-3 flex-wrap justify-center">
			<span class="text-sm text-[#5F6F82] whitespace-nowrap">Pilih Kategori:</span>
			<div class="flex flex-wrap gap-2 bg-gray-100 rounded-xl p-1.5 border border-gray-200">
				for _, t := range data.Tabs {
					<button
						{ swapAttrs(t.Key, false)... }
						class={ "px-4 py-1.5 rounded-lg text-sm transition-all duration-200",
							templ.KV("bg-white text-[#0B2545] font-semibold border border-gray-200 shadow-sm", tab == t.Key),
							templ.KV("text-[#5F6F82] hover:bg-white hover:text-[#0B2545]", tab != t.Key) }
					>
						{ t.Label }
					</button>
				}
			</div>
		</div>
		<!-- IT FILTER — centered below tabs -->
		if tab == "kepanitiaan" {
			<div class="anim-expand flex justify-center mt-1 mb-4">
				<button
					{ swapAttrs(tab, !itOnly)... }
					class={ "px-5 py-1.5 rounded-full text-xs border transition-all duration-200",
						templ.KV("bg-[#0B2545] text-white border-[#0B2545]", itOnly),
						templ.KV("bg-transparent text-[#5F6F82] border-[#5F6F82] hover:border-[#0B2545] hover:text-[#0B2545]", !itOnly) }
				>
					IT
				</button>
			</div>
		}
	</div>
	<!-- TIMELINE -->
	<div class="relative flex flex-col items-center w-full max-w-3xl mx-auto">
		<!-- GARIS TENGAH -->
		<div class="hidden md:block absolute top-0 bottom-0 left-1/2 w-0.5 bg-[#081C33] -translate-x-1/2"></div>
		<div class="anim-fade w-full">
			{{ items := data.Items(tab, itOnly) }}
			if len(items) == 0 {
				<p class="text-center text-[#5F6F82] py-10 text-sm">
					Tidak ada pengalaman dalam kategori ini.
				</p>
			}
			for i, ev := range items {
				<div
					class={ "relative w-full flex my-6",
						templ.KV("anim-slide-left justify-start pr-6 md:pr-12", i%2 == 0),
						templ.KV("anim-slide-right justify-end pl-6 md:pl-12", i%2 != 0) }
					style={ templ.SafeCSS(fmt.Sprintf("animation-delay: %dms", i*80)) }
				>
					<!-- TITIK -->
					<div class="hidden md:block absolute left-1/2 -translate-x-1/2 w-5 h-5 bg-white border-2 border-[#0B2545] rounded-full z-10 top-1/2 -translate-y-1/2"></div>
					<!-- CARD -->
					<div
						hx-get={ fmt.Sprintf("/pengalaman/item?tab=%s&id=%d", tab, ev.ID) }
						hx-target="#modal"
						class={ "card-pop bg-white border-2 border-[#081C33] rounded-xl px-5 py-4 flex items-center gap-4 cursor-pointer select-none w-64 text-sm md:w-80 md:text-base",
							templ.KV("flex-row-reverse text-right", i%2 != 0),
							templ.KV("text-left", i%2 == 0) }
					>
						<!-- ICON -->
						<div class="anim-spin-pop bg-[#F2F6FA] w-10 h-10 min-w-10 min-h-10 rounded-full border border-[#0B2545] flex items-center justify-center text-[#0B2545] font-semibold shrink-0 text-sm">
							{ strconv.Itoa(ev.ID) }
						</div>
						<!-- TEXT -->
						<div>
							<h3 class="font-semibold text-[#0B2545] text-sm leading-snug">
								{ ev.About }
							</h3>
							<p class="text-[#5F6F82] text-xs mt-1">{ ev.Date }</p>
						</div>
					</div>
				</div>
			}
		</div>
	</div>
}

func swapAttrs(tab string, itOnly bool) templ.Attributes {
	q := "tab=" + tab
	if itOnly {
		q += "&it=1"
	}
	return templ.Attributes{
		"hx-get":      "/pengalaman/body?" + q,
		"hx-target":   "#pengalaman-body",
		"hx-push-url": "/pengalaman?" + q,
	}
}

templ Modal(item data.RundownItem) {
	<div class="modal-backdrop fixed inset-0 z-50 flex items-center justify-center px-4">
		<!-- click outside the card closes it -->
		<div
			class="absolute inset-0 bg-black/45"
			hx-get="/pengalaman/close"
			hx-target="#modal"
			hx-swap="innerHTML swap:200ms"
		></div>
		<div class="modal-card bg-white rounded-2xl border border-gray-200 p-6 max-w-md w-full relative">
			<button
				hx-get="/pengalaman/close"
				hx-target="#modal"
				hx-swap="innerHTML swap:200ms"
				class="absolute top-4 right-4 text-[#5F6F82] hover:text-[#0B2545] text-xl leading-none transition-colors"
				aria-label="Tutup"
			>
				✕
			</button>
			<p class="font-semibold text-[#0B2545] text-base pr-6 leading-snug">
				{ item.Role }
			</p>
			<p class="text-sm text-[#5F6F82] mt-1">{ item.Event }</p>
			<p class="text-xs text-gray-400 mt-1 mb-3">{ item.Date }</p>
			<div class="border-t border-gray-100 pt-3 min-h-[60px]">
				<!-- typing effect: each character fades in one after another -->
				<p class="text-sm text-gray-700 leading-relaxed" aria-label={ item.Desc }>
					{{ chars := []rune(item.Desc) }}
					for i, c := range chars {
						<span class="type-ch" aria-hidden="true" style={ templ.SafeCSS(fmt.Sprintf("animation-delay: %dms", i*typeMs)) }>{ string(c) }</span>
					}
					<span
						class="type-cursor inline-block w-0.5 h-3.5 bg-[#0B2545] ml-0.5 align-middle"
						style={ templ.SafeCSS(fmt.Sprintf("--type-end: %dms", len(chars)*typeMs)) }
					></span>
				</p>
			</div>
		</div>
	</div>
}

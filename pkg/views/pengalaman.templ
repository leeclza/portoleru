package views

import (
	"fmt"

	"github.com/leeclza/portofolio-leon/pkg/data"
)

// typing speed per character, same as the old setTimeout(type, 18)
const typeMs = 18

templ PengalamanPage(tab string, itOnly bool) {
	@Layout("Experience — Christopher Leon Saputra") {
		<section id="pengalaman" class="relative isolate overflow-hidden pb-28 pt-32 md:pb-40 md:pt-44">
			<div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
				<div class="grid-bg absolute inset-x-0 top-0 h-[36rem]"></div>
				<div class="orb -right-[15%] -top-[20%] size-[min(40rem,90vw)] bg-violet/15"></div>
			</div>
			<div class="wrap">
				<div class="intro mb-8 flex items-center gap-4" style={ delay(0) }>
					<a href="/#experience" class="label u-link transition-colors hover:text-fg">← Home</a>
					<span class="h-px w-10 bg-line-strong"></span>
					<span class="label text-blue">Experience</span>
				</div>
				<h1 class="font-display text-[clamp(3rem,8vw,8rem)] font-medium leading-[0.92] tracking-[-0.045em]">
					<span class="line"><span style={ delay(0) }>Experience</span></span>
				</h1>
				<p class="intro mt-6 max-w-lg text-muted" style={ delay(1) }>Newest first. Select an item to see the role and what I did.</p>
				<div id="pengalaman-body" class="intro mt-14 md:mt-20" style={ delay(2) }>
					@PengalamanBody(tab, itOnly)
				</div>
			</div>
			<!-- MODAL slot, filled by htmx -->
			<div id="modal"></div>
		</section>
	}
}

// PengalamanBody is the part re-rendered when switching tab or IT filter.
templ PengalamanBody(tab string, itOnly bool) {
	<!-- TABS -->
	<div class="flex flex-col gap-4 border-b border-line pb-6 md:flex-row md:items-center md:justify-between">
		<div class="-mx-[var(--gutter)] overflow-x-auto px-[var(--gutter)] md:mx-0 md:px-0" role="tablist" aria-label="Experience categories">
			<div class="flex w-max gap-1 rounded-full border border-line bg-bg-2 p-1">
				for _, t := range data.Tabs {
					<button
						{ swapAttrs(t.Key, false)... }
						role="tab"
						aria-selected={ fmt.Sprint(tab == t.Key) }
						class={ "whitespace-nowrap rounded-full px-4 py-2 text-sm transition-colors duration-300",
							templ.KV("bg-fg font-medium text-bg", tab == t.Key),
							templ.KV("text-muted hover:text-fg", tab != t.Key) }
					>
						{ t.Label }
						<span class={ "ml-1 font-mono text-[0.7rem]", templ.KV("text-bg/60", tab == t.Key), templ.KV("text-muted/60", tab != t.Key) }>{ fmt.Sprint(data.TabCount(t.Key)) }</span>
					</button>
				}
			</div>
		</div>
		<!-- IT FILTER — only on kepanitiaan -->
		if tab == "kepanitiaan" {
			<button
				{ swapAttrs(tab, !itOnly)... }
				aria-pressed={ fmt.Sprint(itOnly) }
				class={ "anim-fade inline-flex w-max items-center gap-2.5 rounded-full border px-4 py-2 text-sm transition-colors duration-300",
					templ.KV("border-blue bg-blue/10 text-fg", itOnly),
					templ.KV("border-line-strong text-muted hover:border-blue hover:text-fg", !itOnly) }
			>
				<span class={ "size-2 rounded-full border border-blue transition-colors", templ.KV("bg-blue", itOnly) }></span>
				IT only
			</button>
		}
	</div>
	<!-- TIMELINE -->
	{{ items := data.Items(tab, itOnly) }}
	<ol class="anim-fade relative mt-4">
		if len(items) == 0 {
			<li class="py-16 text-center text-sm text-muted">No experience in this category yet.</li>
		}
		for i, ev := range items {
			<li class="anim-item" style={ templ.SafeCSS(fmt.Sprintf("animation-delay: %dms", i*60)) }>
				<button
					type="button"
					hx-get={ fmt.Sprintf("/pengalaman/item?tab=%s&id=%d", tab, ev.ID) }
					hx-target="#modal"
					class="row-hover group grid w-full grid-cols-[1fr_auto] items-center gap-x-6 gap-y-1 border-b border-line py-6 text-left md:grid-cols-[12rem_1fr_auto] md:px-4 md:py-7"
				>
					<span class="label col-span-2 md:col-span-1">{ ev.Date }</span>
					<span>
						<span class="flex items-center gap-3">
							<span class="block font-display text-xl font-medium tracking-tight md:text-2xl">{ ev.Role }</span>
							if ev.IsIT {
								<span class="chip h-6 border-blue/40 px-2 text-[0.65rem] text-blue">IT</span>
							}
						</span>
						<span class="mt-1 block text-muted">{ ev.Event }</span>
					</span>
					<span class="row-icon grid size-10 place-items-center rounded-full border border-line-strong text-muted">
						@arrow("")
					</span>
				</button>
			</li>
		}
	</ol>
}

func swapAttrs(tab string, itOnly bool) templ.Attributes {
	q := "tab=" + tab
	if itOnly {
		q += "&it=1"
	}
	return templ.Attributes{
		"hx-get":      "/pengalaman/body?" + q,
		"hx-target":   "#pengalaman-body",
		"hx-push-url": "/pengalaman?" + q,
	}
}

templ Modal(item data.RundownItem) {
	<div class="modal-backdrop fixed inset-0 z-[60] flex items-end justify-center p-4 sm:items-center" role="dialog" aria-modal="true" aria-labelledby="modal-title">
		<!-- click outside the card closes it -->
		<div
			class="absolute inset-0 bg-bg/70 backdrop-blur-sm"
			hx-get="/pengalaman/close"
			hx-target="#modal"
			hx-swap="innerHTML swap:200ms"
		></div>
		<div class="modal-card relative w-full max-w-lg overflow-hidden rounded-3xl border border-line-strong bg-bg-2 p-7 shadow-2xl shadow-black/50 md:p-9">
			<div class="pointer-events-none absolute -right-20 -top-20 size-56 rounded-full bg-blue/20 blur-3xl" aria-hidden="true"></div>
			<button
				hx-get="/pengalaman/close"
				hx-target="#modal"
				hx-swap="innerHTML swap:200ms"
				class="absolute right-5 top-5 grid size-10 place-items-center rounded-full border border-line-strong text-muted transition-colors hover:border-fg hover:text-fg"
				aria-label="Close"
				autofocus
			>
				✕
			</button>
			<p class="label text-blue">{ item.Date }</p>
			<p id="modal-title" class="mt-4 pr-12 font-display text-2xl font-medium leading-tight tracking-tight md:text-3xl">
				{ item.Role }
			</p>
			<p class="mt-2 text-muted">{ item.Event }</p>
			<div class="mt-6 min-h-[72px] border-t border-line pt-6">
				<!-- typing effect: each character fades in one after another -->
				<p class="leading-relaxed text-fg/85" aria-label={ item.Desc }>
					@typedText(item.Desc)
					<span
						class="type-cursor ml-0.5 inline-block h-4 w-0.5 bg-blue align-middle"
						style={ templ.SafeCSS(fmt.Sprintf("--type-end: %dms", len([]rune(item.Desc))*typeMs)) }
					></span>
				</p>
			</div>
		</div>
	</div>
}

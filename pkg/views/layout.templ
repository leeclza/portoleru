package views

import "fmt"

type navItem struct {
	ID    string
	Label string
}

var navItems = []navItem{
	{"home", "Home"},
	{"about", "About"},
	{"projects", "Projects"},
	{"experience", "Experience"},
	{"certificates", "Certificates"},
	{"contact", "Contact"},
}

type social struct {
	Label string
	Href  string
	Icon  string
}

var socials = []social{
	{"LinkedIn", "https://www.linkedin.com/in/christopher-leon-saputra-114402323/", "linkedin"},
	{"GitHub", "https://github.com/leeclza", "github"},
	{"Instagram", "https://www.instagram.com/c.leonsra", "instagram"},
}

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="theme-color" content="#080B14"/>
			<title>{ title }</title>
			<meta name="description" content="Christopher Leon Saputra — Informatics Engineering student at ITERA focused on full stack web development."/>
			<link rel="icon" href="/favicon.ico"/>
			<!-- reveal styles only hide content once we know JS is running -->
			<script>document.documentElement.classList.add("js")</script>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600&display=swap"/>
			<link rel="stylesheet" href="/styles.css"/>
			<script src="https://unpkg.com/htmx.org@2.0.4/dist/htmx.min.js" defer></script>
			<script src="/js/main.js" defer></script>
		</head>
		<body class="antialiased">
			<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-full focus:bg-fg focus:px-4 focus:py-2 focus:text-bg">Skip to content</a>
			@Navbar()
			<main id="main">
				{ children... }
			</main>
			@SiteFooter()
		</body>
	</html>
}

templ Navbar() {
	<header class="nav fixed inset-x-0 top-0 z-50">
		<nav class="wrap flex h-16 items-center justify-between md:h-20" aria-label="Main">
			<a href="/#home" class="group relative z-50 flex items-center gap-3" aria-label="Leon — home">
				<span class="grid size-9 place-items-center rounded-full border border-line-strong font-display text-sm font-semibold transition-colors duration-300 group-hover:border-blue">L</span>
				<span class="font-display text-[0.95rem] font-medium tracking-[0.3em]">LEON</span>
			</a>
			<ul class="hidden items-center gap-9 md:flex">
				for _, n := range navItems {
					<li>
						<a href={ templ.SafeURL("/#" + n.ID) } data-nav={ n.ID } class="u-link text-sm text-muted transition-colors duration-300 hover:text-fg aria-[current=true]:text-fg">{ n.Label }</a>
					</li>
				}
			</ul>
			<a href="/#contact" class="hidden items-center gap-2 text-sm md:flex">
				<span class="relative flex size-2"><span class="absolute inset-0 animate-ping rounded-full bg-blue opacity-60 motion-reduce:hidden"></span><span class="relative size-2 rounded-full bg-blue"></span></span>
				<span class="u-link">Let's talk</span>
			</a>
			<button id="menu-toggle" type="button" class="burger relative z-50 -mr-2 p-2 md:hidden" aria-controls="menu-panel" aria-expanded="false" aria-label="Open menu">
				<span></span><span></span>
			</button>
		</nav>
		<!-- MOBILE MENU -->
		<div id="menu-panel" class="menu-panel fixed inset-0 z-40 flex flex-col bg-bg md:hidden">
			<div class="wrap flex flex-1 flex-col justify-center gap-2 pt-16">
				for i, n := range navItems {
					<a href={ templ.SafeURL("/#" + n.ID) } style={ templ.SafeCSS(fmt.Sprintf("--i:%d", i)) } class="flex items-baseline gap-4 border-b border-line py-4 font-display text-4xl font-medium tracking-tight">
						<span class="label">{ fmt.Sprintf("0%d", i+1) }</span>
						{ n.Label }
					</a>
				}
			</div>
			<div class="wrap flex gap-6 pb-10 text-sm text-muted">
				for _, s := range socials {
					<a href={ templ.SafeURL(s.Href) } target="_blank" rel="noopener noreferrer" style="--i:6">{ s.Label }</a>
				}
			</div>
		</div>
	</header>
}

templ SiteFooter() {
	<footer class="border-t border-line">
		<div class="wrap flex flex-col gap-8 py-10 md:flex-row md:items-center md:justify-between">
			<div class="flex items-center gap-3">
				<span class="grid size-9 place-items-center rounded-full border border-line-strong font-display text-sm font-semibold">L</span>
				<div class="text-sm">
					<p class="font-medium">Christopher Leon Saputra</p>
					<p class="text-muted">© 2026 · All rights reserved</p>
				</div>
			</div>
			<ul class="flex flex-wrap gap-x-7 gap-y-3 text-sm text-muted">
				for _, s := range socials {
					<li><a href={ templ.SafeURL(s.Href) } target="_blank" rel="noopener noreferrer" class="u-link transition-colors hover:text-fg">{ s.Label }</a></li>
				}
			</ul>
			<a href="#" class="group inline-flex items-center gap-3 text-sm">
				<span class="u-link">Back to top</span>
				<span class="grid size-10 place-items-center rounded-full border border-line-strong transition-all duration-500 group-hover:-translate-y-1 group-hover:border-blue">
					@arrow("-rotate-90")
				</span>
			</a>
		</div>
	</footer>
}

// arrow is a small right-pointing arrow; rotate it with the class.
templ arrow(class string) {
	<svg class={ "size-4", class } viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 8h12M9 3l5 5-5 5"></path></svg>
}

package views

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<meta name="description" content="Generated by Leon"/>
			<link rel="icon" href="/favicon.ico"/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@400;500;700&display=swap"/>
			<link rel="stylesheet" href="/styles.css"/>
			<script src="https://unpkg.com/htmx.org@2.0.4/dist/htmx.min.js" defer></script>
		</head>
		<body class="antialiased">
			<div class="min-h-screen bg-[#EBE9E7]">
				{ children... }
				@Navbar()
				@Cr()
			</div>
		</body>
	</html>
}

templ Navbar() {
	<nav class="fixed top-0 left-0 z-50 w-full bg-[#0b2545]">
		<div class="flex h-16 items-center justify-between px-8">
			<!-- LOGO -->
			<div class="text-white text-2xl font-medium tracking-[0.35em] -mr-[0.35em]">
				<a href="/">LEON</a>
			</div>
			<!-- MENU -->
			<div class="flex items-center gap-8 text-md mr-2">
				<a href="/pengalaman" class="transition-colors duration-200 text-white hover:text-blue-800 hover:underline break-all">
					Pengalaman
				</a>
			</div>
		</div>
	</nav>
}

templ Cr() {
	<div class="w-full bg-[#333333] fix bottom-0">
		<div class="mx-auto max-w-7xl px-6 py-3">
			<p class="text-center text-sm text-white">
				Copyright © 2026. Leon - All Rights Reserved
			</p>
		</div>
	</div>
}

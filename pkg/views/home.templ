package views

import (
	"fmt"
	"strings"

	"github.com/leeclza/portofolio-leon/pkg/data"
)

templ Home() {
	@Layout("Christopher Leon Saputra — Portfolio") {
		@Hero()
		@About()
		@Skills()
		@Projects()
		@Experience()
		@Contact()
	}
}

// sectionLabel is the "01 — About" marker that opens each section.
templ sectionLabel(n, name string) {
	<div class="reveal mb-10 flex items-center gap-4 md:mb-16">
		<span class="label text-blue">{ n }</span>
		<span class="h-px w-10 bg-line-strong"></span>
		<span class="label">{ name }</span>
	</div>
}

func delay(i int) templ.SafeCSS {
	return templ.SafeCSS(fmt.Sprintf("--i:%d", i))
}

templ Hero() {
	<section id="home" class="relative isolate flex min-h-[min(100svh,64rem)] flex-col overflow-hidden pt-24 md:pt-28">
		<!-- BACKGROUND -->
		<div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
			<div class="grid-bg scan absolute inset-0 overflow-hidden"></div>
			<div class="parallax absolute inset-0" data-depth="-28">
				<div class="orb -right-[10%] top-[8%] size-[min(48rem,90vw)] bg-blue/25"></div>
			</div>
			<div class="parallax absolute inset-0" data-depth="18">
				<div class="orb bottom-[-18%] left-[-12%] size-[min(36rem,80vw)] bg-violet/20 [animation-delay:-9s]"></div>
			</div>
			<div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-bg to-transparent"></div>
		</div>
		<div class="wrap flex flex-1 flex-col">
			<!-- TECH META ROW -->
			<div class="intro flex items-center justify-between gap-6" style={ delay(0) }>
				<p class="label flex items-center gap-2"><span class="blink text-blue">●</span> Informatics Engineering Student</p>
				<p class="label hidden sm:block">05°21′S — 105°18′E · ITERA</p>
			</div>
			<!-- HEADLINE -->
			<div class="flex flex-1 flex-col justify-center py-14 md:py-16">
				<h1 class="font-display text-[clamp(2.2rem,7.7vw,9.5rem)] font-medium leading-[0.92] tracking-[-0.045em]">
					<span class="line"><span style={ delay(0) }>Building digital</span></span>
					<span class="line"><span style={ delay(1) }>experiences <em class="font-normal not-italic text-muted">with</em></span></span>
					<span class="line"><span class="grad-text" style={ delay(2) }>code &amp; creativity.</span></span>
				</h1>
				<div class="draw mt-10 h-px w-full bg-gradient-to-r from-blue via-violet/50 to-transparent md:mt-14"></div>
				<div class="mt-8 grid gap-8 md:mt-10 md:grid-cols-12 md:items-end">
					<p class="intro max-w-xl text-base leading-relaxed text-muted md:col-span-6 md:text-lg" style={ delay(1) }>
						I'm <span class="text-fg">Christopher Leon Saputra</span>, a 5th-semester Informatics Engineering student at Institut Teknologi Sumatera (ITERA), focused on full stack web development.
					</p>
					<div class="intro flex flex-wrap gap-3 md:col-span-6 md:justify-end" style={ delay(2) }>
						<a href="#projects" class="btn btn-primary">
							View Projects
							@arrow("arrow")
						</a>
						<a href="#contact" class="btn btn-ghost">Contact Me</a>
					</div>
				</div>
			</div>
			<!-- SCROLL CUE -->
			<div class="intro flex items-end justify-between pb-8" style={ delay(4) }>
				<a href="#about" class="group flex items-center gap-4" aria-label="Scroll to About">
					<span class="relative h-12 w-px overflow-hidden bg-line-strong"><span class="cue absolute inset-0 bg-fg"></span></span>
					<span class="label transition-colors group-hover:text-fg">Scroll</span>
				</a>
				<p class="label">Portfolio — 2026</p>
			</div>
		</div>
	</section>
}

templ About() {
	<section id="about" class="relative py-24 md:py-40">
		<div class="wrap">
			@sectionLabel("01", "About")
			<div class="grid gap-14 md:grid-cols-12 md:gap-10">
				<div class="md:col-span-5">
					<h2 class="section-head">
						<span class="reveal-line block overflow-hidden"><span>Hi, I'm</span></span>
						<span class="reveal-line block overflow-hidden" style={ delay(1) }><span class="grad-text">Leon.</span></span>
					</h2>
					<figure class="reveal relative mt-12 max-w-sm" style={ delay(2) }>
						<div class="relative aspect-[4/5] overflow-hidden rounded-[1.5rem] bg-gradient-to-br from-blue/35 via-bg-3 to-violet/25">
							<img src="/image/pp.png" alt="Photo of Christopher Leon Saputra" loading="lazy" class="absolute inset-0 size-full object-cover"/>
							<div class="absolute inset-0 rounded-[inherit] ring-1 ring-inset ring-line"></div>
						</div>
						<figcaption class="label mt-4 flex justify-between"><span>Lampung, ID</span><span>ITERA · IF 24</span></figcaption>
					</figure>
				</div>
				<div class="md:col-span-6 md:col-start-7 md:pt-4">
					<p class="reveal font-display text-2xl leading-snug tracking-tight md:text-[2.1rem]">
						An Informatics Engineering student who loves building for the web — from clean interfaces to the data flowing behind them.
					</p>
					<div class="reveal mt-10 space-y-5 leading-relaxed text-muted" style={ delay(1) }>
						<p>
							I'm currently in my 5th semester at Institut Teknologi Sumatera. My focus is full stack web development, and right now I'm going deeper into Go.
						</p>
						<p>
							Most of my experience comes from building campus event websites with a team: the front-end for the BUMI KETUPAT e-voting site and PPLK 2025, leading the IT division at IGTTPB 2025, and leading the back-end sub-division for PPLK ITERA 2026.
						</p>
					</div>
					<dl class="mt-14 grid grid-cols-2 border-t border-line">
						@fact(0, "Campus", "Institut Teknologi Sumatera")
						@fact(1, "Major", "Informatics Engineering · 5th Semester")
						@fact(2, "Focus", "Full Stack Web Development")
						<div class="reveal border-b border-l border-line py-5 pl-5" style={ delay(3) }>
							<dt class="label">Status</dt>
							<dd class="mt-2 flex items-center gap-2.5 text-sm md:text-base">
								<span class="relative flex size-2"><span class="absolute inset-0 animate-ping rounded-full bg-blue opacity-60 motion-reduce:hidden"></span><span class="relative size-2 rounded-full bg-blue"></span></span>
								Alive
							</dd>
						</div>
					</dl>
				</div>
			</div>
		</div>
	</section>
}

templ fact(i int, k, v string) {
	<div class={ "reveal border-b border-line py-5", templ.KV("pl-5 border-l", i%2 == 1) } style={ delay(i) }>
		<dt class="label">{ k }</dt>
		<dd class="mt-2 text-sm md:text-base">{ v }</dd>
	</div>
}

templ Skills() {
	<section id="skills" class="relative border-y border-line bg-bg-2/40 py-24 md:py-36">
		<div class="wrap">
			@sectionLabel("02", "Tech Stack")
			<div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
				<h2 class="section-head">
					<span class="reveal-line block overflow-hidden"><span>Tools I</span></span>
					<span class="reveal-line block overflow-hidden" style={ delay(1) }><span>work with.</span></span>
				</h2>
				<p class="reveal max-w-xs text-muted" style={ delay(2) }>Languages, frameworks, databases, and tools I use to learn and build projects.</p>
			</div>
		</div>
		<div class="mt-16 border-t border-line md:mt-24">
			for i, g := range data.Stack {
				<div class="reveal grid border-b border-line md:grid-cols-[16rem_1fr]" style={ delay(i) }>
					<div class="wrap flex items-center gap-3 pt-6 md:w-auto md:border-r md:border-line md:py-0 md:pr-6">
						<span class="label text-blue">{ fmt.Sprintf("0%d", i+1) }</span>
						<h3 class="label text-fg">{ g.Label }</h3>
					</div>
					<!-- screen readers get a plain list; the moving row is decorative -->
					<ul class="sr-only">
						for _, t := range g.Items {
							<li>{ t.Name }</li>
						}
					</ul>
					<div class="marquee overflow-hidden py-6" aria-hidden="true">
						<div class="marquee-track" style={ templ.SafeCSS(fmt.Sprintf("--dur:%ds", 30+i*6)) }>
							for range 2 {
								for _, t := range data.Repeat(g.Items, 9) {
									<span class="mr-3 flex items-center gap-3 rounded-2xl border border-line bg-bg py-2 pl-2 pr-5 transition-colors duration-300 hover:border-blue/50">
										<img src={ "/icons/" + t.Icon + ".svg" } alt="" width="40" height="40" loading="lazy" class="size-10 rounded-[0.6rem]"/>
										<span class="whitespace-nowrap text-sm font-medium">{ t.Name }</span>
									</span>
								}
							}
						</div>
					</div>
				</div>
			}
		</div>
	</section>
}

// visibleCount is how many projects show before "Show All".
const visibleCount = 2

templ Projects() {
	<section id="projects" class="relative py-24 md:py-40">
		<div class="wrap">
			@sectionLabel("03", "Selected Work")
			<div class="mb-16 flex flex-col gap-6 md:mb-24 md:flex-row md:items-end md:justify-between">
				<h2 class="section-head">
					<span class="reveal-line block overflow-hidden"><span>Projects &amp;</span></span>
					<span class="reveal-line block overflow-hidden" style={ delay(1) }><span class="grad-text">case studies.</span></span>
				</h2>
				<p class="reveal max-w-sm text-muted" style={ delay(2) }>Websites I've built with campus event teams, plus this portfolio itself.</p>
			</div>
			<!-- extra cards are collapsed by main.js; without JS everything shows -->
			<div id="project-list" class="grid gap-x-10 gap-y-20 md:grid-cols-2 md:gap-y-28">
				for i, p := range data.Projects {
					@projectCard(i, p)
				}
			</div>
			<div class="proj-toggle-row mt-20 flex items-center gap-6">
				<span class="h-px flex-1 bg-line"></span>
				<button
					id="project-toggle"
					type="button"
					aria-controls="project-list"
					aria-expanded="false"
					class="btn btn-ghost"
				>
					<span data-more>{ fmt.Sprintf("Show All (%d)", len(data.Projects)) }</span>
					<span data-less hidden>Show Less</span>
					@arrow("toggle-arrow rotate-90 transition-transform duration-500")
				</button>
				<span class="h-px flex-1 bg-line"></span>
			</div>
		</div>
	</section>
}

templ projectCard(i int, p data.Project) {
	<article
		class={ "proj reveal group relative", templ.KV("md:mt-40", i%2 == 1), templ.KV("proj-extra", i >= visibleCount) }
		aria-labelledby={ fmt.Sprintf("project-title-%d", p.ID) }
	>
		<div class="proj-media relative aspect-[16/11]">
			<img src={ p.Image } alt={ "Screenshot of " + p.Title } loading="lazy" class="absolute inset-0 size-full object-cover"/>
			<div class="proj-glow"></div>
			<div class="absolute left-4 top-4 flex gap-2">
				<span class="label rounded-full bg-bg/70 px-3 py-1.5 text-fg! backdrop-blur">{ fmt.Sprintf("%02d / %02d", p.ID, len(data.Projects)) }</span>
				if i < 2 {
					<span class="label flex items-center gap-1.5 rounded-full bg-gradient-to-r from-blue to-violet px-3 py-1.5 text-white!">
						<span class="blink size-1.5 rounded-full bg-white"></span>
						Recent
					</span>
				}
			</div>
		</div>
		<div class="mt-7 flex items-start justify-between gap-6">
			<div>
				<p class="label">
					{ p.Category }
					if p.Year != "" {
						{ " · " + p.Year }
					}
				</p>
				<h3 id={ fmt.Sprintf("project-title-%d", p.ID) } class="mt-3 font-display text-2xl font-medium tracking-tight md:text-[2rem] md:leading-tight">
					{ p.Title }
				</h3>
			</div>
			if p.Link != "" {
				<a href={ templ.SafeURL(p.Link) } target="_blank" rel="noopener noreferrer" aria-label={ "Open " + p.Title + " (new tab)" } class="proj-cta grid size-12 shrink-0 place-items-center rounded-full border border-line-strong">
					@arrow("")
				</a>
			}
		</div>
		<p class="mt-4 max-w-xl leading-relaxed text-muted">{ p.Description }</p>
		<div class="mt-6 flex flex-wrap items-center gap-2">
			<span class="chip border-blue/40 text-blue">{ p.Role }</span>
			for _, s := range p.Stack {
				<span class="chip">{ s }</span>
			}
			if p.Link != "" {
				<a href={ templ.SafeURL(p.Link) } target="_blank" rel="noopener noreferrer" class="u-link ml-auto text-sm text-muted transition-colors hover:text-fg">{ strings.TrimSuffix(strings.TrimPrefix(p.Link, "https://www."), "/") }</a>
			}
		</div>
	</article>
}


templ Experience() {
	<section id="experience" class="relative border-t border-line py-24 md:py-40">
		<div class="wrap">
			@sectionLabel("04", "Experience")
			<div class="grid gap-16 md:grid-cols-12">
				<div class="md:col-span-5">
					<h2 class="section-head">
						<span class="reveal-line block overflow-hidden"><span>Journey so</span></span>
						<span class="reveal-line block overflow-hidden" style={ delay(1) }><span>far.</span></span>
					</h2>
					<p class="reveal mt-6 max-w-sm text-muted" style={ delay(2) }>Committees, internships, organizations, and training during my studies at ITERA.</p>
					<div class="mt-12 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line">
						for i, t := range data.Tabs {
							<a href={ templ.SafeURL("/pengalaman?tab=" + t.Key) } class="reveal group bg-bg p-5 transition-colors duration-300 hover:bg-bg-2 md:p-6" style={ delay(i) }>
								<span class="block font-display text-4xl font-medium tracking-tight transition-colors group-hover:text-blue md:text-5xl">{ fmt.Sprintf("%02d", data.TabCount(t.Key)) }</span>
								<span class="mt-2 block text-sm text-muted">{ t.Label }</span>
							</a>
						}
					</div>
				</div>
				<div class="md:col-span-7">
					<p class="reveal label mb-6">Highlights — IT committees</p>
					<ol class="relative border-l border-line">
						for i, ev := range data.Items("kepanitiaan", true) {
							<li class="reveal relative" style={ delay(i) }>
								<span class={ "absolute -left-[5px] top-8 size-[9px] rounded-full border border-blue", templ.KV("bg-blue shadow-[0_0_0_4px_rgb(108_140_255/0.18)]", ongoing(ev.Date)), templ.KV("bg-bg", !ongoing(ev.Date)) } aria-hidden="true"></span>
								<a href={ templ.SafeURL("/pengalaman?tab=kepanitiaan&it=1") } class="row-hover grid gap-1 py-6 pl-8 md:grid-cols-[1fr_auto] md:items-center md:gap-6 md:pr-4">
									<div>
										<p class="label">{ ev.Date }</p>
										<h3 class="mt-2 font-display text-xl font-medium tracking-tight md:text-2xl">{ ev.Role }</h3>
										<p class="mt-1 text-muted">{ ev.Event }</p>
									</div>
									<span class="row-icon hidden text-muted md:block">
										@arrow("")
									</span>
								</a>
							</li>
						}
					</ol>
					<a href="/pengalaman" class="btn btn-ghost reveal mt-10">
						View all experience
						@arrow("arrow")
					</a>
				</div>
			</div>
		</div>
	</section>
}

templ Contact() {
	<section id="contact" class="relative isolate overflow-hidden border-t border-line py-28 md:py-44">
		<div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
			<div class="orb left-1/2 top-1/2 size-[min(50rem,110vw)] -translate-x-1/2 -translate-y-1/2 bg-blue/15"></div>
			<div class="grid-bg absolute inset-0 opacity-60"></div>
		</div>
		<div class="wrap">
			@sectionLabel("05", "Contact")
			<h2 class="font-display text-[clamp(2.4rem,7.2vw,8.5rem)] font-medium leading-[0.92] tracking-[-0.045em]">
				<span class="reveal-line block overflow-hidden"><span>Let's build</span></span>
				<span class="reveal-line block overflow-hidden" style={ delay(1) }><span>something</span></span>
				<span class="reveal-line block overflow-hidden" style={ delay(2) }><span class="grad-text">meaningful.</span></span>
			</h2>
			<div class="mt-16 grid gap-12 md:mt-24 md:grid-cols-12">
				<div class="reveal md:col-span-5">
					<p class="max-w-sm leading-relaxed text-muted">Open to project collaborations, IT committee roles, or just a chat about web development. The fastest way to reach me is Instagram.</p>
					<a href={ templ.SafeURL(socials[2].Href) } target="_blank" rel="noopener noreferrer" class="btn btn-primary mt-8">
						Message me on Instagram
						@arrow("arrow")
					</a>
				</div>
				<ul class="border-t border-line md:col-span-6 md:col-start-7">
					for i, s := range socials {
						<li class="reveal" style={ delay(i) }>
							<a href={ templ.SafeURL(s.Href) } target="_blank" rel="noopener noreferrer" class="row-hover flex items-center gap-5 border-b border-line px-1 py-6 md:px-4">
								<img src={ "/icons/" + s.Icon + ".svg" } alt="" width="40" height="40" loading="lazy" class="size-10 rounded-[0.6rem]"/>
								<span class="font-display text-2xl font-medium tracking-tight md:text-3xl">{ s.Label }</span>
								<span class="ml-auto hidden text-sm text-muted sm:block">{ handle(s.Href) }</span>
								<span class="row-icon text-muted">
									@arrow("")
								</span>
							</a>
						</li>
					}
				</ul>
			</div>
		</div>
	</section>
}

// handle shows the last path segment of a profile URL, e.g. "@leeclza".
func handle(href string) string {
	parts := strings.Split(strings.TrimSuffix(href, "/"), "/")
	h := parts[len(parts)-1]
	if strings.Contains(href, "linkedin") {
		return "in/christopher-leon-saputra"
	}
	return "@" + h
}

// ongoing reports whether an experience date range is still running.
func ongoing(date string) bool {
	return strings.HasSuffix(date, data.Ongoing)
}
